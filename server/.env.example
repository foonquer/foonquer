# 복사해서 .env로 쓴다 (cp .env.example .env). .env는 커밋하지 않는다.
NODE_ENV=development
PORT=3000

# mysql://사용자:비밀번호@호스트:포트/DB이름
DATABASE_URL=mysql://root:password@localhost:3307/foonquer

# 쉼표로 여러 개. 비우면 모든 출처 허용(개발용)
CORS_ORIGINS=http://localhost:5173

# accessToken(JWT) 서명 키. 32자 이상 임의 문자열 (운영은 SSM에 따로 둔다)
JWT_ACCESS_SECRET=local-dev-only-secret-change-me-0123456789

# 서버 앞 프록시 단계 수 (nginx·로드밸런서·Cloudflare). 로컬은 0
TRUST_PROXY=0

# 쿠키 Secure 속성 (http://localhost에서도 동작해서 보통 true 그대로)
COOKIE_SECURE=true

# 웹(프론트) 주소. 카카오 로그인 콜백에 쓴다
FRONTEND_URL=http://localhost:5173

# 이 API 서버의 바깥 주소. 카카오 로그인 redirect_uri = {API_BASE_URL}/api/v1/auth/oauth/kakao/callback
API_BASE_URL=http://localhost:3000

# 카카오 REST API 키 (카카오 로그인 + 로컬 API), Client Secret은 카카오 콘솔에서 켰을 때만
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# 프로필·리뷰 사진 공개 주소. 예) https://storage.googleapis.com/버킷 또는 Cloud CDN 도메인. 비우면 사진 URL을 null로 준다
IMAGE_BASE_URL=
# 사진을 두는 Cloud Storage 버킷. 올린 사진 key가 있는지 확인한다. 비우면 사진 key를 받지 않는다
# VM 서비스 계정에 그 버킷의 roles/storage.objectViewer가 필요하다 (없으면 403이 나서 500이 난다)
GCS_BUCKET=
# 영수증·현장·문의 사진을 두는 비공개 버킷 (공개 접근 없음, 조회는 서버가 만든 signed URL로만)
GCS_PRIVATE_BUCKET=

# 네이버 CLOVA OCR 영수증 특화 모델 (방문 인증 VISIT-03). 비우면 영수증 인증이 '영수증을 읽기 어려워요'로 실패한다
CLOVA_OCR_URL=
CLOVA_OCR_SECRET=

# 테스트 DB (pnpm -C server test). 이름이 _test로 끝나야 한다. 비우면 아래 기본값을 쓴다.
# TEST_DATABASE_URL=mysql://root:password@localhost:3307/foonquer_test
