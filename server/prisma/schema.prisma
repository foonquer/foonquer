// 먹장깨기 Prisma 스키마
// 원본: docs ERD v1.2 (먹장깨기-ERD.dbml). ERD를 바꾸면 이 파일도 같이 고친다.
// - 테이블·컬럼 이름은 DB에서 snake_case(@@map/@map), 코드에서는 camelCase로 쓴다.
// - CHECK 제약은 Prisma가 표현하지 못해서 마이그레이션 SQL(prisma/migrations)에 직접 넣는다.
// - 코드값 컬럼(char(1) 등)의 값 목록은 각 필드 위 주석에 있다.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

model Member {
  id                      BigInt                    @id @default(autoincrement())
  /// 카카오 회원번호 (카카오 로그인이 주는 사용자 고유 id) — 로그인은 카카오 하나만 쓴다. 탈퇴하면 비워서 같은 카카오 계정으로 다시 가입할 수 있게 한다
  kakaoId                 String?                   @unique @map("kakao_id") @db.VarChar(20)
  /// 2~10자 (한글·영문·숫자) · 프로필 설정(S-04) 전에는 null
  nickname                String?                   @unique @db.VarChar(10)
  /// 닉네임은 30일에 한 번만 변경 가능 — 이 값으로 확인
  nicknameChangedAt       DateTime?                 @map("nickname_changed_at")
  /// M 남성 / F 여성 / N 선택 안 함
  gender                  String?                   @db.Char(1)
  /// 10 / 20 / 30 / 40 / 50(50대 이상)
  ageGroup                Int?                      @map("age_group") @db.TinyInt
  /// 내 동네(member_local_region)를 마지막으로 바꾼 시각 — 내 동네는 한 시즌에 한 번만 바꿀 수 있다. 회원가입 때 처음 고른 것은 세지 않는다
  localChangedAt          DateTime?                 @map("local_changed_at")
  /// 프로필 사진 스토리지 key · null이면 먹깨비를 프로필로 사용
  profileImageKey         String?                   @map("profile_image_key") @db.VarChar(255)
  /// 탐방러 프로필 소개글 (선택, 60자) — 2026-10-13 인플루언서 소개글 결정, ERD v1.2
  bio                     String?                   @db.VarChar(60)
  /// 대표 칭호 종류 — A 업적 칭호(rep_title_ref = achievement.id) / T 시즌 티어 칭호(rep_title_ref = season_region_stat.id, 지금 티어 이름으로 보여 준다) · null이면 이번 시즌 가장 높은 티어 칭호 (ERD v1.2)
  repTitleType            String?                   @map("rep_title_type") @db.Char(1)
  repTitleRef             BigInt?                   @map("rep_title_ref")
  /// 신뢰 온도 T — 1°~99°, 시작 50°. 도움돼요(방문자 +0.2°, 비방문자 +0.05°), 방문 인증 리뷰 작성(+0.1°), 별로예요 기준 충족(N ≥ 5이고 N ≥ 2H, 리뷰당 1번 −0.5°), 신고 확정(−3°), 허위 리뷰 판정(−5°)으로 바뀐다. 하루 최대 +1°, 75° 이상은 오르는 양이 절반. 바뀔 때마다 trust_temp_log에 남긴다. 작성자 가중치 w_user = 1 + (T − 50) / 50 (0.5~1.5)
  trustTemp               Decimal                   @default(50) @map("trust_temp") @db.Decimal(4, 2)
  /// 먹포인트 잔액 — 항상 point_history 합계와 같아야 한다
  pointBalance            Int                       @default(0) @map("point_balance")
  /// 정복·리뷰 알림
  conquestAlarm           Boolean                   @default(true) @map("conquest_alarm")
  /// 먹짱·순위 변동 알림
  rankAlarm               Boolean                   @default(true) @map("rank_alarm")
  /// 이벤트·혜택 알림 — 켜고 끌 때 member_consent(MARKETING)도 함께 기록
  marketingAlarm          Boolean                   @default(false) @map("marketing_alarm")
  /// 내 취향 (v1.4, 피그마 3-2 "무엇을 중요하게 보세요?") — 1 보통 / 2 중요 / 3 아주 중요. 내 종합 별점 = 항목 평균 × (내 점수 ÷ 다섯 항목 합)
  weightTaste             Int                       @default(1) @map("weight_taste") @db.TinyInt
  weightCleanliness       Int                       @default(1) @map("weight_cleanliness") @db.TinyInt
  weightPortion           Int                       @default(1) @map("weight_portion") @db.TinyInt
  weightService           Int                       @default(1) @map("weight_service") @db.TinyInt
  weightPrice             Int                       @default(1) @map("weight_price") @db.TinyInt
  /// 맞춤 퀘스트 받기 (피그마 12. 설정 "맞춤 퀘스트") — 끄면 홈 퀘스트 아이콘이 사라지고 새 퀘스트를 받지 않는다
  questEnabled            Boolean                   @default(true) @map("quest_enabled")
  /// 방문 기록으로 맞춤 추천 — 끄면 퀘스트가 내 기록 대신 동네 인기순 일반 추천으로 바뀐다. 기록은 다른 사람에게 안 보인다
  personalizedReco        Boolean                   @default(true) @map("personalized_reco")
  /// P 프로필 설정 전 / A 활성 / S 이용 정지 / D 탈퇴
  status                  String                    @default("P") @db.Char(1)
  /// U 일반 회원 / A 운영자 — /api/v1/admin을 쓸 수 있다 (v1.3). 운영자는 DB에서 직접 지정한다
  role                    String                    @default("U") @db.Char(1)
  lastLoginAt             DateTime?                 @map("last_login_at")
  regDate                 DateTime                  @default(now()) @map("reg_date")
  updateDate              DateTime?                 @updatedAt @map("update_date")
  /// 탈퇴 시각 — 탈퇴하면 kakao_id·nickname을 비워 같은 카카오 계정으로 다시 가입하거나 다른 사람이 닉네임을 쓸 수 있게 한다
  deleteDate              DateTime?                 @map("delete_date")
  /// 탈퇴한 회원의 스토리지 사진(영수증·현장·문의·프로필 폴더)을 다 지운 시각 (v1.3) — null이면 cleanup 작업이 하루 1번 다시 지운다
  filesPurgedAt           DateTime?                 @map("files_purged_at")
  memberLocalRegions      MemberLocalRegion[]
  preferredCategories     MemberPreferredCategory[]
  memberWithdrawals       MemberWithdrawal[]
  refreshTokens           RefreshToken[]
  memberConsents          MemberConsent[]
  pushSubscriptions       PushSubscription[]
  savedRestaurants        SavedRestaurant[]
  searchHistories         SearchHistory[]
  visits                  Visit[]
  conquests               Conquest[]
  reviews                 Review[]
  reviewReactions         ReviewReaction[]
  seasonRegionStats       SeasonRegionStat[]
  seasonResults           SeasonResult[]
  memberAchievements      MemberAchievement[]
  mukkaebi                Mukkaebi?
  memberRegionBackgrounds MemberRegionBackground[]
  pointHistories          PointHistory[]
  expHistories            ExpHistory[]
  memberItems             MemberItem[]
  notifications           Notification[]
  inquiries               Inquiry[]
  reports                 Report[]
  blockerMemberBlocks     MemberBlock[]             @relation("member_block_blocker_id")
  blockedMemberBlocks     MemberBlock[]             @relation("member_block_blocked_id")
  trustTempLogs           TrustTempLog[]            @relation("trust_temp_log_user_id")
  actedTrustTempLogs      TrustTempLog[]            @relation("trust_temp_log_actor_id")
  activityLogs            MemberActivityLog[]
  picks                   MemberPick[]
  itemBoxes               MemberItemBox[]
  questWeeks              QuestWeek[]
  quests                  Quest[]
  questDislikes           QuestDislike[]

  @@map("member")
}

/// 내 동네(로컬). 회원가입 S-06에서 처음 고르고, 내 정보 → 내 동네 추가로 늘린다. 한 사람 최대 2곳 — 사는 동네 + 1곳 (앱에서 확인).
/// 집뿐 아니라 직장 근처처럼 자주 가는 동네도 고를 수 있다.
/// 방문 인증 때 이 표의 구 중에 가게의 구가 있으면 visit.is_local = true → 리뷰 카드에 "로컬", 아니면 "외부 방문"
/// 좋아하는 음식 종류 (2026-11-04, 3차 멘토링 개인화). 회원가입 S-05-1에서 여러 개 고른다. 첫 추천 맛집(RECO-01)에서 고른 카테고리를 먼저 보여 준다
model MemberPreferredCategory {
  userId     BigInt   @map("user_id")
  categoryId Int      @map("category_id")
  regDate    DateTime @default(now()) @map("reg_date")
  user       Member   @relation(fields: [userId], references: [id])
  category   Category @relation(fields: [categoryId], references: [id])

  @@id([userId, categoryId])
  @@index([categoryId], map: "member_preferred_category_category_idx")
  @@map("member_preferred_category")
}

model MemberLocalRegion {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  /// 고른 동 (region.level = 3)
  regionId  Int      @map("region_id")
  /// 그 동이 속한 구 (level = 2) — 로컬 판정이 구 단위라서 따로 둔다
  sigunguId Int      @map("sigungu_id")
  /// 고른 순서 0~2 — 0번 동네의 구를 현황·랭킹 화면의 기본 구로 쓴다(초안)
  sortOrder Int      @default(0) @map("sort_order") @db.TinyInt
  regDate   DateTime @default(now()) @map("reg_date")
  user      Member   @relation(fields: [userId], references: [id])
  region    Region   @relation("member_local_region_region_id", fields: [regionId], references: [id])
  sigungu   Region   @relation("member_local_region_sigungu_id", fields: [sigunguId], references: [id])

  @@unique([userId, regionId], map: "member_local_region_uk")
  @@unique([userId, sortOrder], map: "member_local_region_order_uk")
  @@index([sigunguId], map: "member_local_region_sigungu_idx")
  @@map("member_local_region")
}

/// 회원 탈퇴 화면의 떠나는 이유 — 개인정보 없이 이유만 남겨 서비스 개선에 쓴다
model MemberWithdrawal {
  id           BigInt   @id @default(autoincrement())
  userId       BigInt   @map("user_id")
  /// RARELY_USE 자주 쓰지 않음 / NO_RESTAURANT 가고 싶은 맛집이 없음 / VERIFY_HARD 영수증 인증이 번거로움 / ETC 기타 · 선택 안 하면 null
  reasonCode   String?  @map("reason_code") @db.VarChar(20)
  reasonDetail String?  @map("reason_detail") @db.VarChar(255)
  regDate      DateTime @default(now()) @map("reg_date")
  user         Member   @relation(fields: [userId], references: [id])

  @@map("member_withdrawal")
}

model RefreshToken {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt    @map("user_id")
  /// refresh token의 SHA-256
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  /// 로그아웃·재발급 시각
  revokedAt DateTime? @map("revoked_at")
  regDate   DateTime  @default(now()) @map("reg_date")
  user      Member    @relation(fields: [userId], references: [id])

  @@index([userId], map: "refresh_token_user_idx")
  @@index([expiresAt], map: "refresh_token_expires_idx")
  @@map("refresh_token")
}

model AuthTemporaryToken {
  id        BigInt    @id @default(autoincrement())
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  /// OAUTH_RESULT 카카오 로그인 콜백 결과 교환 코드(1분)
  tokenType String    @map("token_type") @db.VarChar(20)
  /// OAUTH_RESULT { kakaoId }
  payload   Json
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  regDate   DateTime  @default(now()) @map("reg_date")

  @@index([tokenType, expiresAt], map: "auth_temporary_token_type_expires_idx")
  @@map("auth_temporary_token")
}

/// 동의를 바꿀 때마다 새 행을 추가한다 (이력 보관). 최신 상태 = consent_type별 가장 큰 id
model MemberConsent {
  id            BigInt    @id @default(autoincrement())
  userId        BigInt    @map("user_id")
  /// TERMS 서비스 이용약관(필수) / PRIVACY 개인정보 수집·이용(필수) / LOCATION 위치기반 서비스(필수) / MARKETING 이벤트·혜택 알림(선택)
  consentType   String    @map("consent_type") @db.VarChar(20)
  agreed        Boolean   @default(false)
  policyVersion String    @map("policy_version") @db.VarChar(20)
  agreedAt      DateTime? @map("agreed_at")
  withdrawnAt   DateTime? @map("withdrawn_at")
  regDate       DateTime  @default(now()) @map("reg_date")
  user          Member    @relation(fields: [userId], references: [id])

  @@index([userId, consentType, id], map: "member_consent_user_type_id_idx")
  @@map("member_consent")
}

/// [2차] 푸시 알림을 붙일 때 사용
model PushSubscription {
  id           BigInt    @id @default(autoincrement())
  userId       BigInt    @map("user_id")
  /// PWA Web Push 구독 주소
  endpoint     String    @db.VarChar(1024)
  /// endpoint의 SHA-256 — 긴 문자열에 unique를 걸지 않기 위해
  endpointHash String    @unique @map("endpoint_hash") @db.Char(64)
  p256dh       String    @db.VarChar(255)
  auth         String    @db.VarChar(255)
  userAgent    String?   @map("user_agent") @db.VarChar(255)
  regDate      DateTime  @default(now()) @map("reg_date")
  updateDate   DateTime? @updatedAt @map("update_date")
  user         Member    @relation(fields: [userId], references: [id])

  @@index([userId], map: "push_subscription_user_idx")
  @@map("push_subscription")
}

/// 구 경계 폴리곤(GeoJSON)은 DB가 아니라 프론트 정적 파일로 둔다
model Region {
  id                        Int                      @id @default(autoincrement())
  /// 법정동 코드 10자리 (카카오 coord2regioncode의 B 코드). 시·도/구는 뒤를 0으로 채운 코드
  code                      String                   @unique @db.VarChar(10)
  /// 서울특별시 / 강서구 / 가양동
  name                      String                   @db.VarChar(20)
  /// 서울특별시 강서구 가양동
  fullName                  String                   @map("full_name") @db.VarChar(60)
  /// 1 시·도 / 2 시·군·구 / 3 동
  level                     Int                      @db.TinyInt
  parentId                  Int?                     @map("parent_id")
  /// 먹짱 지도에서 아바타를 놓을 중심 좌표
  centerLat                 Decimal?                 @map("center_lat") @db.Decimal(10, 7)
  centerLng                 Decimal?                 @map("center_lng") @db.Decimal(10, 7)
  /// 구(level = 2)의 특색 배경 에셋 이름 (예: BG_MAPO_WORLDCUP) — 먹깨비 뒤 배경. 사는 것이 아니라 그 구에서 가게 10곳을 정복하면 저절로 얻는다(member_region_background)
  bgKey                     String?                  @map("bg_key") @db.VarChar(40)
  parent                    Region?                  @relation("region_parent_id", fields: [parentId], references: [id])
  regionMemberLocalRegions  MemberLocalRegion[]      @relation("member_local_region_region_id")
  sigunguMemberLocalRegions MemberLocalRegion[]      @relation("member_local_region_sigungu_id")
  children                  Region[]                 @relation("region_parent_id")
  regionRestaurants         Restaurant[]             @relation("restaurant_region_id")
  sigunguRestaurants        Restaurant[]             @relation("restaurant_sigungu_id")
  conquests                 Conquest[]
  seasonRegionStats         SeasonRegionStat[]
  seasonResults             SeasonResult[]
  mukkaebis                 Mukkaebi[]
  memberRegionBackgrounds   MemberRegionBackground[]
  quests                    Quest[]

  @@index([parentId, name], map: "region_parent_name_idx")
  @@index([level], map: "region_level_idx")
  @@map("region")
}

model Season {
  id                 Int                 @id @default(autoincrement())
  /// 시즌 1, 2, 3 …
  seasonNo           Int                 @unique @map("season_no")
  /// 예) 시즌 3 = 2026-09-01
  startDate          DateTime            @map("start_date") @db.Date
  /// 예) 시즌 3 = 2027-02-28 (포함)
  endDate            DateTime            @map("end_date") @db.Date
  /// U 예정 / A 진행 중 / E 종료(집계 중) / F 순위·칭호 확정
  status             String              @default("U") @db.Char(1)
  finalizedAt        DateTime?           @map("finalized_at")
  regDate            DateTime            @default(now()) @map("reg_date")
  visits             Visit[]
  conquests          Conquest[]
  seasonRegionStats  SeasonRegionStat[]
  seasonResults      SeasonResult[]
  memberAchievements MemberAchievement[]
  memberItems        MemberItem[]

  @@map("season")
}

/// 카카오 category_name → 우리 카테고리 매핑 (모든 가게는 카테고리가 있음, 안 맞으면 기타)
/// 음식점 > 한식(육류,고기·해물,생선 제외) → 한식 / 음식점 > 한식 > 육류,고기 → 고깃집 / 음식점 > 한식 > 해물,생선 → 해산물
/// 음식점 > 중식·일식·양식·분식·치킨·패스트푸드 → 같은 이름 / 음식점 > 아시아음식 → 아시안
/// 카테고리 그룹 CE7, 음식점 > 카페, 음식점 > 간식(제과·베이커리·디저트) → 카페·디저트 / 그 외(음식점 > 술집·뷔페·퓨전요리·도시락 등) → 기타
model Category {
  id          Int                       @id @default(autoincrement())
  /// id 순서(= sort_order, 검색 홈 칩 순서): 1 한식 / 2 중식 / 3 일식 / 4 양식 / 5 분식 / 6 고깃집 / 7 해산물 / 8 치킨 / 9 패스트푸드 / 10 아시안 / 11 카페·디저트 / 12 기타(술집·뷔페·퓨전·도시락 등) — 배달 앱 카테고리, 술집은 기타에 포함 (2026-10-08 12개로 확정)
  name        String                    @unique @db.VarChar(20)
  sortOrder   Int                       @default(0) @map("sort_order") @db.TinyInt
  restaurants Restaurant[]
  preferredBy MemberPreferredCategory[]

  @@map("category")
}

model Restaurant {
  id               BigInt                 @id @default(autoincrement())
  /// 공공데이터 소상공인시장진흥공단 상가(상권)정보의 상가업소번호 — 주기 작업 store-import가 이 번호로 가게를 갱신한다. 카카오에서 저장했던 옛 가게 중 공공데이터와 이어지지 않은 것만 null
  bizesId          String?                @unique @map("bizes_id") @db.VarChar(30)
  /// 카카오 장소 ID — 카카오 결과는 저장하면 안 되고 ID만 저장할 수 있다. 음식점 상세(REST-01)에서 카카오로 같은 가게를 처음 찾았을 때 저장. 못 찾았으면 null
  kakaoPlaceId     String?                @unique @map("kakao_place_id") @db.VarChar(20)
  /// 상호명 + 지점명 (공공데이터)
  name             String                 @db.VarChar(100)
  /// 공공데이터 업종 소분류를 우리 카테고리로 매핑
  categoryId       Int?                   @map("category_id")
  /// 공공데이터 업종 소분류 이름. 예) 국수/칼국수 — 맛집 검색(SEARCH-02)에서 검색어와 비교한다
  categoryDetail   String?                @map("category_detail") @db.VarChar(100)
  roadAddress      String?                @map("road_address") @db.VarChar(255)
  jibunAddress     String?                @map("jibun_address") @db.VarChar(255)
  /// 동 (level = 3)
  regionId         Int                    @map("region_id")
  /// 구 (level = 2) — 랭킹·검색·로컬 판정에 자주 쓰여서 따로 둔다
  sigunguId        Int                    @map("sigungu_id")
  /// 현장 인증 거리 계산의 기준 좌표
  lat              Decimal                @db.Decimal(10, 7)
  lng              Decimal                @db.Decimal(10, 7)
  /// 사업자등록번호 — 처음 인증된 영수증에서 얻는다. 같은 이름 다른 지점 구분에 사용
  businessNo       String?                @map("business_no") @db.VarChar(12)
  /// 영업시간 — 공공데이터·카카오 API가 주지 않으므로 직접 입력한 경우만 (없으면 화면에서 숨김). 형식: 요일(mon~sun)별 open/close 배열, 한국 시간 24시간제. 예) {"mon":[{"open":"11:00","close":"21:00"}],"sun":[]} · 쉬는 요일은 빈 배열, 점심·저녁 따로 영업하면 배열에 2개
  businessHours    Json?                  @map("business_hours")
  /// 마패가 붙어 있는지 — 표시 중인 restaurant_mapae(status = A)가 있으면 true. 검색 목록·음식점 상세에서 "리뷰 이벤트를 하는 가게입니다"를 보여 줄 때 바로 읽으려고 둔다
  hasMapae         Boolean                @default(false) @map("has_mapae")
  /// A 영업 / C 폐업 / H 숨김
  status           String                 @default("A") @db.Char(1)
  regDate          DateTime               @default(now()) @map("reg_date")
  updateDate       DateTime?              @updatedAt @map("update_date")
  category         Category?              @relation(fields: [categoryId], references: [id])
  region           Region                 @relation("restaurant_region_id", fields: [regionId], references: [id])
  sigungu          Region                 @relation("restaurant_sigungu_id", fields: [sigunguId], references: [id])
  restaurantStat   RestaurantStat?
  savedRestaurants SavedRestaurant[]
  visits           Visit[]
  conquests        Conquest[]
  reviews          Review[]
  mukkaebis        Mukkaebi[]
  mapaes           RestaurantMapae[]
  aspectStats      RestaurantAspectStat[]
  picks            MemberPick[]
  quests           Quest[]                @relation("quest_restaurant_id")
  doneQuests       Quest[]                @relation("quest_done_restaurant_id")

  @@index([sigunguId, categoryId], map: "restaurant_sigungu_category_idx")
  @@index([regionId, categoryId], map: "restaurant_region_category_idx")
  @@index([lat, lng], map: "restaurant_latlng_idx")
  @@index([businessNo], map: "restaurant_business_no_idx")
  @@map("restaurant")
}

/// 음식점 상세·추천맛집용 집계. 비율 대신 개수를 저장해서 리뷰가 추가·삭제될 때 +1/-1로 정확히 갱신한다. review.score_weight가 바뀌면 그 차이만큼 weight_sum·weighted_score_sum을 고친다
/// 마패 (2026-11-04). 뒷광고 또는 리뷰 이벤트가 확인된 가게에 "리뷰 이벤트를 하는 가게입니다"를 붙인다. 운영자가 확인한 뒤 붙이고, 붙이거나 해제할 때 restaurant.has_mapae를 함께 바꾼다(한 트랜잭션). 해제해도 행은 지우지 않는다(이력)
model RestaurantMapae {
  id            BigInt     @id @default(autoincrement())
  restaurantId  BigInt     @map("restaurant_id")
  /// A 뒷광고(협찬을 숨긴 리뷰) / E 리뷰 이벤트(리뷰를 쓰면 혜택을 주는 이벤트)
  reason        String     @db.Char(1)
  /// 운영자가 확인한 근거 — 신고 내용, 리뷰 id, 매장 안내문 사진 등 요약
  evidence      String?    @db.VarChar(500)
  /// 계기가 된 신고 (있을 때)
  reportId      BigInt?    @map("report_id")
  /// 계기가 된 리뷰 — Gemini가 협찬·이벤트 문구를 찾은 리뷰 등 (있을 때)
  reviewId      BigInt?    @map("review_id")
  /// A 표시 중 / R 해제
  status        String     @default("A") @db.Char(1)
  /// 붙인 운영자 (관리자 화면이 없으면 이름이나 메일)
  grantedBy     String     @map("granted_by") @db.VarChar(50)
  grantedAt     DateTime   @map("granted_at")
  /// 해제 시각 — 이벤트가 끝났거나 잘못 붙인 경우
  releasedAt    DateTime?  @map("released_at")
  releaseReason String?    @map("release_reason") @db.VarChar(255)
  regDate       DateTime   @default(now()) @map("reg_date")
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id])
  report        Report?    @relation(fields: [reportId], references: [id])
  review        Review?    @relation(fields: [reviewId], references: [id])

  @@index([restaurantId, status], map: "restaurant_mapae_restaurant_idx")
  @@map("restaurant_mapae")
}

model RestaurantStat {
  restaurantId       BigInt     @id @map("restaurant_id")
  /// 인증 평가 수 (공개 리뷰)
  reviewCount        Int        @default(0) @map("review_count")
  textReviewCount    Int        @default(0) @map("text_review_count")
  photoReviewCount   Int        @default(0) @map("photo_review_count")
  /// 리뷰 overall_score(종합 별점)의 합 — 단순 평균 = score_sum / review_count
  scoreSum           Decimal    @default(0) @map("score_sum") @db.Decimal(12, 1)
  /// Σw — 계산에 넣는 공개 리뷰의 최종 가중치 w = score_weight × 시간 감쇠 d 의 합 (ERD v1.0)
  weightSum          Decimal    @default(0) @map("weight_sum") @db.Decimal(10, 3)
  /// Σ(w × r) — 같은 리뷰들의 최종 가중치 × 종합 별점(overall_score) 합
  weightedScoreSum   Decimal    @default(0) @map("weighted_score_sum") @db.Decimal(12, 3)
  /// 화면의 대표 별점 R = (C × m + Σ(w × r)) / (C + Σw), 소수 첫째 자리. C·m은 rating_param(PRIOR_WEIGHT, GLOBAL_MEAN). 리뷰가 0개면 null → "아직 별점이 없어요"
  displayScore       Decimal?   @map("display_score") @db.Decimal(2, 1)
  /// display_score를 계산한 시각
  displayScoreAt     DateTime?  @map("display_score_at")
  cleanlinessSum     Int        @default(0) @map("cleanliness_sum")
  portionSum         Int        @default(0) @map("portion_sum")
  serviceSum         Int        @default(0) @map("service_sum")
  priceSum           Int        @default(0) @map("price_sum")
  /// 세부 별점(청결·양·서비스·가격)을 남긴 리뷰 수 — 항목별 평균의 분모
  detailReviewCount  Int        @default(0) @map("detail_review_count")
  /// 맛 별점 3.0 이상(다시 먹을 의향, v1.4) 리뷰 수 → 재방문 의사 % = revisit_intent_count ÷ review_count
  revisitIntentCount Int        @default(0) @map("revisit_intent_count")
  /// 성공한 방문 인증 수 (영수증 + 현장)
  visitCount         Int        @default(0) @map("visit_count")
  /// 로컬 방문 수 (visit.is_local = true) → 현지인 방문 %
  localVisitCount    Int        @default(0) @map("local_visit_count")
  /// 방문한 사람 수
  visitorCount       Int        @default(0) @map("visitor_count")
  /// 2번 이상 방문한 사람 수 → 재방문 %
  revisitorCount     Int        @default(0) @map("revisitor_count")
  /// 이 가게를 정복한 사람 수 ("12명이 이미 정복했어요")
  conquerorCount     Int        @default(0) @map("conqueror_count")
  saveCount          Int        @default(0) @map("save_count")
  updateDate         DateTime?  @updatedAt @map("update_date")
  restaurant         Restaurant @relation(fields: [restaurantId], references: [id])

  @@map("restaurant_stat")
}

/// 가고 싶은 곳. 정복하면 목록에서는 빠지지만(조회 시 conquest와 비교) 행은 지우지 않는다
model SavedRestaurant {
  userId       BigInt     @map("user_id")
  restaurantId BigInt     @map("restaurant_id")
  /// "저장한 지 12일이 지났어요" 알림을 보낸 시각 (중복 알림 방지)
  remindedAt   DateTime?  @map("reminded_at")
  /// 메모 (선택, 50자) — 피그마 맛집 추가 · 저장하기 "예: 수제비도 맛있대요" (ERD v1.2)
  memo         String?    @db.VarChar(50)
  /// "2주 뒤에 알려 주기" — false면 저장 12일 알림을 보내지 않는다 (ERD v1.2)
  remind       Boolean    @default(true)
  regDate      DateTime   @default(now()) @map("reg_date")
  user         Member     @relation(fields: [userId], references: [id])
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])

  @@id([userId, restaurantId])
  @@index([userId, regDate], map: "saved_restaurant_user_date_idx")
  @@map("saved_restaurant")
}

/// [2차] 최근 검색 — 브라우저 저장소로 대신해도 된다
model SearchHistory {
  id      BigInt   @id @default(autoincrement())
  userId  BigInt   @map("user_id")
  keyword String   @db.VarChar(50)
  regDate DateTime @default(now()) @map("reg_date")
  user    Member   @relation(fields: [userId], references: [id])

  @@index([userId, regDate], map: "search_history_user_date_idx")
  @@map("search_history")
}

/// 현장 인증은 체류 시간 확인 없이 위치 확인 1번 + 갤러리 음식 사진 1장으로 끝난다 (2026-10-02)
model Visit {
  id                BigInt             @id @default(autoincrement())
  userId            BigInt             @map("user_id")
  /// 인증한 가게 — 가게 상세에서 시작하면 처음부터, 홈에서 영수증을 바로 찍으면 "이 가게가 맞나요?" 확인 후 채운다
  restaurantId      BigInt?            @map("restaurant_id")
  /// 영수증 인증은 결제일(paid_at), 현장 인증은 인증 시각(verified_at)이 속한 시즌 — 인증 성공 시 채움
  seasonId          Int?               @map("season_id")
  /// R 영수증 인증 / S 현장 인증(위치 확인 + 갤러리 음식 사진)
  method            String             @db.Char(1)
  /// P 영수증 읽는 중 / R 가게 확인 대기 / L 위치 확인 완료(현장 인증, 음식 사진 대기) / V 인증 완료(별점 대기, 먹깨비 이동 중) / C 정복 완료(별점 등록) / F 실패
  status            String             @default("P") @db.Char(1)
  /// 영수증: UNREADABLE 영수증을 읽기 어려움 / DUPLICATE 이미 인증한 영수증 / STORE_MISMATCH 가게 정보가 다름 / EXPIRED 7일 지난 영수증 · 현장: TOO_FAR 매장 밖(100m 초과) / PHOTO_UNCLEAR 음식이 잘 보이지 않음 / PHOTO_MISMATCH 사진의 위치·촬영 시간이 맞지 않음
  failReason        String?            @map("fail_reason") @db.VarChar(20)
  /// 영수증 사진 스토리지 key — 영수증 인증(method = R)만
  receiptImageKey   String?            @map("receipt_image_key") @db.VarChar(255)
  /// CLOVA OCR(영수증 특화 모델) 응답 중 필요한 부분 — 매장 정보, 결제 내역, 금액, 메뉴 줄
  ocrRaw            Json?              @map("ocr_raw")
  ocrStoreName      String?            @map("ocr_store_name") @db.VarChar(100)
  ocrBusinessNo     String?            @map("ocr_business_no") @db.VarChar(12)
  /// 카드 승인번호 (있을 때)
  ocrApprovalNo     String?            @map("ocr_approval_no") @db.VarChar(20)
  /// 영수증 가게명이 고른 가게와 같은지 ("가게명 일치")
  storeNameMatched  Boolean?           @map("store_name_matched")
  /// 사업자번호가 같은지 ("사업자번호 일치")
  businessNoMatched Boolean?           @map("business_no_matched")
  /// 결제 일시 — 7일 이내만 인증 (영수증 인증)
  paidAt            DateTime?          @map("paid_at")
  /// 결제 금액 (원)
  totalAmount       Int?               @map("total_amount")
  /// SHA-256(사업자번호|결제일시|금액|승인번호) — 성공한 인증에만 채워서 같은 영수증 재사용을 막는다
  receiptHash       String?            @unique @map("receipt_hash") @db.Char(64)
  /// 현장 인증: 위치 확인 때 기기 좌표
  checkinLat        Decimal?           @map("checkin_lat") @db.Decimal(10, 7)
  checkinLng        Decimal?           @map("checkin_lng") @db.Decimal(10, 7)
  /// GPS 정확도 (m)
  checkinAccuracy   Int?               @map("checkin_accuracy") @db.SmallInt
  /// 가게까지 거리 (m) — 100m 이내면 통과 ("매장에서 42m · 인증 범위 100m 이내")
  checkinDistanceM  Int?               @map("checkin_distance_m") @db.SmallInt
  /// 위치 확인 시각
  checkinAt         DateTime?          @map("checkin_at")
  /// 현장 인증: 갤러리에서 고른 음식 사진 스토리지 key (앱 안에서 직접 찍지 않는다)
  sitePhotoKey      String?            @map("site_photo_key") @db.VarChar(255)
  /// 사진 EXIF 촬영 시각 — 없으면 null
  photoTakenAt      DateTime?          @map("photo_taken_at")
  /// 사진 EXIF 위치 — 브라우저가 지우면 null, 있으면 가게 좌표와 비교해 보강 검증
  photoLat          Decimal?           @map("photo_lat") @db.Decimal(10, 7)
  photoLng          Decimal?           @map("photo_lng") @db.Decimal(10, 7)
  /// 인증 시점에 작성자의 내 동네 구(member_local_region) 중 가게의 구가 있는지 — 리뷰 카드의 로컬/외부 방문 표시와 현지인 방문 %에 사용. 나중에 내 동네를 바꿔도 이 값은 그대로 둔다
  isLocal           Boolean            @default(false) @map("is_local")
  verifiedAt        DateTime?          @map("verified_at")
  /// 탈퇴로 영수증·현장 사진, 좌표, OCR·결제 정보를 지운 시각 (v1.3). 채워지면 인증 방식별 필수 CHECK를 보지 않는다
  purgedAt          DateTime?          @map("purged_at")
  regDate           DateTime           @default(now()) @map("reg_date")
  updateDate        DateTime?          @updatedAt @map("update_date")
  user              Member             @relation(fields: [userId], references: [id])
  restaurant        Restaurant?        @relation(fields: [restaurantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  season            Season?            @relation(fields: [seasonId], references: [id])
  visitReceiptItems VisitReceiptItem[]
  conquest          Conquest?
  review            Review?
  inquiries         Inquiry[]

  @@index([userId, regDate], map: "visit_user_date_idx")
  @@index([userId, restaurantId, status], map: "visit_user_restaurant_idx")
  @@index([restaurantId, status], map: "visit_restaurant_status_idx")
  @@index([status, regDate], map: "visit_status_idx")
  @@map("visit")
}

/// OCR로 읽은 메뉴 줄 (영수증 인증만) — 메뉴 검색, 가게별 인기 메뉴, 데이터 분석에 사용
model VisitReceiptItem {
  id       BigInt @id @default(autoincrement())
  visitId  BigInt @map("visit_id")
  menuName String @map("menu_name") @db.VarChar(50)
  quantity Int    @default(1) @db.SmallInt
  /// 줄 금액 (원)
  price    Int?
  visit    Visit  @relation(fields: [visitId], references: [id])

  @@index([visitId], map: "visit_receipt_item_visit_idx")
  @@index([menuName], map: "visit_receipt_item_menu_idx")
  @@map("visit_receipt_item")
}

/// 한 시즌에 같은 가게는 한 번만 정복으로 센다. 누적 정복 = restaurant_id를 중복 없이 센 수
model Conquest {
  id           BigInt     @id @default(autoincrement())
  userId       BigInt     @map("user_id")
  restaurantId BigInt     @map("restaurant_id")
  seasonId     Int        @map("season_id")
  /// 가게의 구 (랭킹 집계 단위) — 가게 정보가 바뀌어도 기록은 그대로 두려고 복사
  sigunguId    Int        @map("sigungu_id")
  /// 정복을 만든 방문 인증
  visitId      BigInt     @unique @map("visit_id")
  /// 별점 등록 = 정복 완료 시각
  conqueredAt  DateTime   @map("conquered_at")
  user         Member     @relation(fields: [userId], references: [id])
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  season       Season     @relation(fields: [seasonId], references: [id])
  sigungu      Region     @relation(fields: [sigunguId], references: [id])
  visit        Visit      @relation(fields: [visitId], references: [id])

  @@unique([userId, restaurantId, seasonId], map: "conquest_user_restaurant_season_uk")
  @@index([seasonId, sigunguId, userId], map: "conquest_season_sigungu_idx")
  @@index([userId, conqueredAt], map: "conquest_user_date_idx")
  @@index([restaurantId, seasonId], map: "conquest_restaurant_idx")
  @@map("conquest")
}

model Review {
  id                  BigInt             @id @default(autoincrement())
  /// 방문 인증(영수증·현장) 1건에 리뷰 1개 — 인증 없이 리뷰를 쓸 수 없다. 인증 방식과 로컬 여부는 visit에서 읽는다
  visitId             BigInt             @unique @map("visit_id")
  userId              BigInt             @map("user_id")
  restaurantId        BigInt             @map("restaurant_id")
  /// 맛 별점 0.5~5.0, 0.5 단위(10단계, 맛 기준표) · 이것만 남기면 정복 (v1.4, 피그마 3-2). 재방문 의사가 이 점수에 포함된다(3.0 이상 다시 먹을 의향 / 2.5 이하 재방문 의사 없음)
  overallScore        Decimal            @map("overall_score") @db.Decimal(2, 1)
  /// 청결 1~5 · 세부 별점(선택, 맛은 맛 별점으로 남겨서 뺐다 v1.4): 네 항목을 모두 고르거나 모두 비운다
  cleanliness         Int?               @db.TinyInt
  /// 양 1~5 · 세부 별점
  portion             Int?               @db.TinyInt
  /// 서비스 1~5 · 세부 별점
  service             Int?               @db.TinyInt
  /// 가격 만족도 1~5 · 세부 별점
  price               Int?               @db.TinyInt
  /// 세부평가(세부 별점·좋았던/아쉬웠던 점·세부 리뷰)를 등록한 시각 — 종합 별점과 따로 나중에 남길 수 있다
  detailRegDate       DateTime?          @map("detail_reg_date")
  /// 세부 리뷰 (선택, 최대 300자) · null이면 글 없이 남긴 리뷰
  content             String?            @db.VarChar(300)
  /// 글 리뷰를 쓴 시각
  contentRegDate      DateTime?          @map("content_reg_date")
  imageCount          Int                @default(0) @map("image_count") @db.TinyInt
  /// 도움돼요 수 (화면 표시용, 방문자 + 비방문자)
  helpfulCount        Int                @default(0) @map("helpful_count")
  /// H — 그 가게를 방문 인증한 사람이 누른 도움돼요 중 반영된 것(review_reaction.is_visitor·is_counted). 공감 점수에 쓴다
  visitorHelpfulCount Int                @default(0) @map("visitor_helpful_count")
  /// N — 별로예요 수 (비공개). 방문 인증한 사람만 누를 수 있다. N ≥ 5이고 N ≥ 2H가 되면 작성자 온도 −0.5°(리뷰당 1번)
  unhelpfulCount      Int                @default(0) @map("unhelpful_count")
  /// 같은 가게를 2번 이상 방문 인증한 뒤 쓴 리뷰면 true → 재방문 가중치 v = 1.1. 리뷰를 쓸 때 정한다
  isRevisit           Boolean            @default(false) @map("is_revisit")
  /// AI 리뷰 분석 결과(Gemini API) — 글 길이, 사진 첨부 여부, AI가 쓴 글 같은 말투인지 등. 무료 티어 호출 한도 때문에 리뷰 작성 후 비동기로 분석하고, 한도를 넘거나 실패하면 ai_checked_at을 null로 두고 score_weight는 1.00으로 시작한다
  aiResult            Json?              @map("ai_result")
  /// AI 분석 시각 · null이면 아직 분석 전
  aiCheckedAt         DateTime?          @map("ai_checked_at")
  /// AI가 협찬·리뷰 이벤트 문구를 찾으면 true — 운영자 마패 확인 목록에 가게를 올린다. 계산식에는 직접 들어가지 않는다
  adSuspected         Boolean            @default(false) @map("ad_suspected")
  /// 시간 감쇠를 뺀 리뷰 가중치 = clamp(w_user × w_help, 0.5, 2.0) × v → 0.5~2.2. 시간 감쇠 d는 가게 별점 계산 때 reg_date 기준으로 곱한다
  scoreWeight         Decimal            @default(1) @map("score_weight") @db.Decimal(4, 3)
  /// A 공개 / H 블라인드(신고 처리) / F 허위 판정 / D 삭제 — A만 가게 별점 계산에 넣는다
  status              String             @default("A") @db.Char(1)
  /// 종합 별점 등록 시각
  regDate             DateTime           @default(now()) @map("reg_date")
  updateDate          DateTime?          @updatedAt @map("update_date")
  visit               Visit              @relation(fields: [visitId], references: [id])
  user                Member             @relation(fields: [userId], references: [id])
  restaurant          Restaurant         @relation(fields: [restaurantId], references: [id])
  reviewImages        ReviewImage[]
  reviewReactions     ReviewReaction[]
  mapaes              RestaurantMapae[]
  aspectMarks         ReviewAspectMark[]

  @@index([restaurantId, status, regDate], map: "review_restaurant_latest_idx")
  @@index([restaurantId, status, helpfulCount], map: "review_restaurant_helpful_idx")
  @@index([userId, regDate], map: "review_user_date_idx")
  @@index([adSuspected, aiCheckedAt], map: "review_ad_suspected_idx")
  @@map("review")
}

model ReviewImage {
  id        BigInt   @id @default(autoincrement())
  reviewId  BigInt   @map("review_id")
  /// 스토리지 key
  imageKey  String   @map("image_key") @db.VarChar(255)
  /// 0~4 (최대 5장)
  sortOrder Int      @default(0) @map("sort_order") @db.TinyInt
  regDate   DateTime @default(now()) @map("reg_date")
  review    Review   @relation(fields: [reviewId], references: [id])

  @@unique([reviewId, sortOrder], map: "review_image_order_uk")
  @@map("review_image")
}

/// 평가에 참여하면 먹포인트를 준다(reward_policy REVIEW_VOTE). point_history는 ref_type = REVIEW_REACTION, ref_id = 이 행 id로 남겨서, 눌렀다 취소하고 다시 눌러도 한 리뷰에 한 번만 받는다. 리뷰 열람 횟수 제한은 없다(2026-10-06 삭제)
model ReviewReaction {
  id         BigInt    @id @default(autoincrement())
  reviewId   BigInt    @map("review_id")
  userId     BigInt    @map("user_id")
  /// H 도움돼요 / U 별로예요(비공개) / N 취소 — 자기 리뷰에는 누를 수 없다(앱에서 확인). 별로예요는 그 가게를 방문 인증한 사람만 누를 수 있다. 취소해도 행을 지우지 않는다
  type       String    @db.Char(1)
  /// 누른 사람이 그 가게를 방문 인증했는지 (누를 때 정한다) — 방문자의 도움돼요만 review.visitor_helpful_count(H)에 넣는다
  isVisitor  Boolean   @default(false) @map("is_visitor")
  /// 계산에 반영되는지 — 같은 사람이 같은 작성자에게 준 도움돼요는 월 3회, 별로예요는 월 1회까지만 반영한다
  isCounted  Boolean   @default(true) @map("is_counted")
  regDate    DateTime  @default(now()) @map("reg_date")
  updateDate DateTime? @updatedAt @map("update_date")
  review     Review    @relation(fields: [reviewId], references: [id])
  user       Member    @relation(fields: [userId], references: [id])

  @@unique([reviewId, userId], map: "review_reaction_review_user_uk")
  @@index([userId], map: "review_reaction_user_idx")
  @@map("review_reaction")
}

/// 현황·랭킹·먹짱 지도·TOP 50·칭호를 모두 이 표에서 읽는다.
/// 정복이 생기면 conquest_count +1, 순위·상위 %·티어는 배치(예: 5분마다)로
/// RANK() OVER (PARTITION BY season_id, sigungu_id ORDER BY conquest_count DESC, last_conquered_at) 로 다시 계산한다.
/// 활동 탐험가 수 = 같은 (season_id, sigungu_id)에서 conquest_count > 0인 행 수
model SeasonRegionStat {
  id              BigInt    @id @default(autoincrement())
  seasonId        Int       @map("season_id")
  sigunguId       Int       @map("sigungu_id")
  userId          BigInt    @map("user_id")
  conquestCount   Int       @default(0) @map("conquest_count")
  /// 동점이면 먼저 도달한 사람이 위
  lastConqueredAt DateTime? @map("last_conquered_at")
  /// 구 안 순위 (RANK는 MySQL 예약어라 rank_no)
  rankNo          Int?      @map("rank_no")
  /// 상위 % — 시즌 보상 방망이·밤하늘을 정하는 기준
  topPercent      Decimal?  @map("top_percent") @db.Decimal(5, 2)
  /// B 초보 탐방러(0~4곳) / R 단골(5곳~) / G 미식가(20곳~) / C 정복자(20곳~ + 상위 10%) / M 먹짱(1위)
  tier            String    @default("B") @db.Char(1)
  /// 티어 상승 축하 화면을 마지막으로 보여 준 티어 — tier와 다르면 축하 화면을 띄운다
  celebratedTier  String    @default("B") @map("celebrated_tier") @db.Char(1)
  /// 시즌이 끝나고 확정되면 true — 시즌 기록·칭호 화면이 이 값을 본다
  isFinalized     Boolean   @default(false) @map("is_finalized")
  updateDate      DateTime? @updatedAt @map("update_date")
  season          Season    @relation(fields: [seasonId], references: [id])
  sigungu         Region    @relation(fields: [sigunguId], references: [id])
  user            Member    @relation(fields: [userId], references: [id])

  @@unique([seasonId, sigunguId, userId], map: "season_region_stat_uk")
  @@index([seasonId, sigunguId, rankNo], map: "season_region_stat_rank_idx")
  @@index([userId, seasonId], map: "season_region_stat_user_idx")
  @@map("season_region_stat")
}

/// 시즌 확정 배치가 사람마다 1행씩 만든다
model SeasonResult {
  id               BigInt    @id @default(autoincrement())
  seasonId         Int       @map("season_id")
  userId           BigInt    @map("user_id")
  /// 가장 높은 순위(상위 %)를 받은 구 — 시즌 결과 발표 화면의 대표 결과
  bestSigunguId    Int       @map("best_sigungu_id")
  /// season_region_stat.tier와 같은 코드
  bestTier         String    @map("best_tier") @db.Char(1)
  bestRankNo       Int       @map("best_rank_no")
  /// 시즌 보상을 정하는 기준 — season_reward_rule과 비교
  bestTopPercent   Decimal?  @map("best_top_percent") @db.Decimal(5, 2)
  /// 그 시즌 전체 정복 수 (모든 구 합계)
  conquestTotal    Int       @default(0) @map("conquest_total")
  /// 시즌 보상 먹포인트 — point_history(SEASON_REWARD)와 같은 값
  rewardPoint      Int       @default(0) @map("reward_point")
  /// 이 시즌에 받은 도깨비 방망이 (나무·청동·은·황금 중 1개) — best_top_percent에 맞는 CLUB 아이템. 먹짱(1위)도 황금. 왕관·밤하늘은 member_item(season_id)에 남긴다
  rewardClubItemId Int?      @map("reward_club_item_id")
  /// 시즌 결과 발표 화면을 본 시각 · null이면 앱을 열 때 보여 준다
  seenAt           DateTime? @map("seen_at")
  regDate          DateTime  @default(now()) @map("reg_date")
  season           Season    @relation(fields: [seasonId], references: [id])
  user             Member    @relation(fields: [userId], references: [id])
  bestSigungu      Region    @relation(fields: [bestSigunguId], references: [id])
  rewardClubItem   Item?     @relation(fields: [rewardClubItemId], references: [id])

  @@unique([seasonId, userId], map: "season_result_uk")
  @@map("season_result")
}

/// 시즌 확정 배치가 season_result를 만들 때 쓰는 보상표. 초안:
/// P 10 → 황금 방망이 + 밤하늘 / P 30 → 은 방망이 / P 50 → 청동 방망이 / P 100 → 나무 방망이 / R 1 → 왕관
/// 방망이(CLUB)는 걸린 규칙 중 threshold가 가장 낮은 1개만 주고, 왕관·밤하늘 같은 명예 아이템은 걸린 규칙을 모두 준다.
/// 1위는 상위 10%에도 들어서 황금 방망이·밤하늘·왕관을 모두 받는다(2026-10-06 확정).
/// 받은 아이템은 member_item(acquired_type = S, season_id)에 넣는다.
model SeasonRewardRule {
  id        Int      @id @default(autoincrement())
  /// R 순위 / P 상위 %
  ruleType  String   @map("rule_type") @db.Char(1)
  /// R이면 몇 위까지(먹짱 = 1), P이면 상위 몇 % 이내(10 / 30 / 50 / 100)
  threshold Decimal  @db.Decimal(5, 2)
  /// 주는 아이템 — 방망이(CLUB) 또는 명예 아이템(왕관·밤하늘)
  itemId    Int      @map("item_id")
  regDate   DateTime @default(now()) @map("reg_date")
  item      Item     @relation(fields: [itemId], references: [id])

  @@unique([ruleType, threshold, itemId], map: "season_reward_rule_uk")
  @@map("season_reward_rule")
}

/// 활동 업적. 시즌별 티어 칭호(강서구 단골 등)는 season_region_stat에서 보여준다
model Achievement {
  id                 Int                 @id @default(autoincrement())
  /// FIRST_CONQUEST / REVIEW_10 / REVIEW_50 / HELPFUL_300 / SEASON_CONQUEST_30 / SEASON_TOP10 / MUKJJANG …
  code               String              @unique @db.VarChar(40)
  /// 첫 정복 / 리뷰 10개 / 도움왕 / 구의 먹짱 …
  name               String              @db.VarChar(30)
  description        String?             @db.VarChar(255)
  /// CONQUEST_TOTAL / SEASON_CONQUEST / DISTRICT_COUNT(탐험한 구 수) / REVIEW_TEXT_COUNT / REVIEW_PHOTO_COUNT / HELPFUL_RECEIVED / WEEKLY_STREAK / SEASON_RANK / SEASON_TIER
  conditionType      String              @map("condition_type") @db.VarChar(30)
  /// 목표값 (10개, 300회, TOP 10 …)
  conditionValue     Int                 @map("condition_value")
  rewardPoint        Int                 @default(0) @map("reward_point")
  /// 프론트 아이콘 이름
  iconKey            String?             @map("icon_key") @db.VarChar(100)
  sortOrder          Int                 @default(0) @map("sort_order")
  status             String              @default("A") @db.Char(1)
  memberAchievements MemberAchievement[]
  items              Item[]

  @@map("achievement")
}

model MemberAchievement {
  id            BigInt      @id @default(autoincrement())
  userId        BigInt      @map("user_id")
  achievementId Int         @map("achievement_id")
  /// 시즌과 관련된 업적이면 처음 달성한 시즌
  seasonId      Int?        @map("season_id")
  achievedAt    DateTime    @default(now()) @map("achieved_at")
  /// 달성 축하 화면을 본 시각 · null이면 축하 이벤트(CHAR-08)로 띄운다 (ERD v1.2)
  seenAt        DateTime?   @map("seen_at")
  user          Member      @relation(fields: [userId], references: [id])
  achievement   Achievement @relation(fields: [achievementId], references: [id])
  season        Season?     @relation(fields: [seasonId], references: [id])

  @@unique([userId, achievementId], map: "member_achievement_uk")
  @@map("member_achievement")
}

/// 크기 단계는 level로 계산한다(level_policy, 뿔 단계는 2026-10-06 삭제). 배경은 얻은 구 배경 중 내가 고른 것(bg_sigungu_id → region.bg_key)을 쓴다(2026-10-06). 처음 얻은 배경은 자동으로 골라 두고, 여러 개면 꾸미기에서 바꾼다(초안). 가진 아이템인지는 member_item으로 확인하고, 안 가진 아이템은 착용할 수 없다(앱에서 확인). 음식 분야 깨비와 색깔은 만들지 않는다(2026-10-06)
model Mukkaebi {
  /// 회원 1명에 먹깨비 1마리
  userId              BigInt      @id @map("user_id")
  level               Int         @default(1)
  /// 누적 경험치
  exp                 Int         @default(0)
  /// 쓰고 있는 모자 (item.category = HAT, 왕관 포함) · 없으면 null
  hatItemId           Int?        @map("hat_item_id")
  /// 쓰고 있는 얼굴 아이템 (item.category = FACE) · 없으면 null
  faceItemId          Int?        @map("face_item_id")
  /// 들고 있는 소품 (item.category = PROP) · 없으면 null
  propItemId          Int?        @map("prop_item_id")
  /// 밤하늘을 쓰고 있으면 그 아이템 (item.category = SKIN) · null이면 기본 코랄
  skinItemId          Int?        @map("skin_item_id")
  /// 들고 다니는 도깨비 방망이 (item.category = CLUB) · 아직 없으면 null — 소품과 별개로 한 자리를 쓴다
  clubItemId          Int?        @map("club_item_id")
  /// 지도 위 먹깨비 위치 = 마지막으로 정복한 가게
  currentRestaurantId BigInt?     @map("current_restaurant_id")
  /// 골라 둔 구 배경 (region.level = 2, member_region_background에 있는 구만) · null이면 기본 배경
  bgSigunguId         Int?        @map("bg_sigungu_id")
  /// 성장 축하 화면을 마지막으로 보여 준 레벨
  celebratedLevel     Int         @default(1) @map("celebrated_level")
  updateDate          DateTime?   @updatedAt @map("update_date")
  user                Member      @relation(fields: [userId], references: [id])
  hatItem             Item?       @relation("mukkaebi_hat_item_id", fields: [hatItemId], references: [id])
  faceItem            Item?       @relation("mukkaebi_face_item_id", fields: [faceItemId], references: [id])
  propItem            Item?       @relation("mukkaebi_prop_item_id", fields: [propItemId], references: [id])
  skinItem            Item?       @relation("mukkaebi_skin_item_id", fields: [skinItemId], references: [id])
  clubItem            Item?       @relation("mukkaebi_club_item_id", fields: [clubItemId], references: [id])
  currentRestaurant   Restaurant? @relation(fields: [currentRestaurantId], references: [id])
  bgSigungu           Region?     @relation(fields: [bgSigunguId], references: [id])

  @@map("mukkaebi")
}

/// 구 배경 획득 (2026-10-06 결정: 그 구에서 10곳 정복하면 저절로 얻고, 여러 개면 골라 씀)
/// - 정복 저장(conquest INSERT) 때 그 구에서 정복한 서로 다른 가게 수를 세어 10 이상이고 행이 없으면 INSERT
/// - 세는 기준은 모든 시즌 누적, 서로 다른 restaurant_id (초안 — 시즌마다 다시 세는지는 팀 확인 필요)
/// - 한 번 얻으면 시즌이 바뀌어도 사라지지 않는다 (초안)
/// - 10은 숫자를 바꿀 수 있게 reward_policy 같은 설정 값으로 두면 좋다
model MemberRegionBackground {
  id         BigInt    @id @default(autoincrement())
  userId     BigInt    @map("user_id")
  /// 얻은 구 배경 (region.level = 2)
  sigunguId  Int       @map("sigungu_id")
  /// 얻은 시각
  unlockedAt DateTime  @map("unlocked_at")
  /// 해금 축하 화면을 본 시각 · null이면 축하 이벤트(CHAR-08)로 띄운다 (ERD v1.2)
  seenAt     DateTime? @map("seen_at")
  user       Member    @relation(fields: [userId], references: [id])
  sigungu    Region    @relation(fields: [sigunguId], references: [id])

  @@unique([userId, sigunguId], map: "member_region_background_uk")
  @@map("member_region_background")
}

model LevelPolicy {
  level       Int    @id
  /// 이 레벨이 되는 누적 경험치
  requiredExp Int    @map("required_exp")
  /// E 알(LV.1~2) / B 아기(LV.3~9) / K 어린이(LV.10~19) / A 다 큼(LV.20~, 여기서 크기가 멈춤)
  stage       String @db.Char(1)
  /// 깨비를 그릴 크기 — 아기 60 / 어린이 80 / 다 큼 100 (알은 100)
  sizePercent Int    @default(100) @map("size_percent") @db.TinyInt
  /// 레벨업 보상 먹포인트
  rewardPoint Int    @default(0) @map("reward_point")

  @@map("level_policy")
}

/// 보상 수치를 코드가 아니라 표에 두어서 배포 없이 조정한다
model RewardPolicy {
  /// VISIT_VERIFIED / REVIEW_TEXT / REVIEW_PHOTO / HELPFUL_RECEIVED / REVIEW_VOTE / FIRST_CONQUEST / LEVEL_UP / TIER_UP / SEASON_REWARD / ITEM_BOX(상자에서 줄 아이템이 없을 때)
  reason      String  @id @db.VarChar(30)
  /// 초안: 방문 인증 +50 / 글 리뷰 +30 / 사진 리뷰 +20 / 도움돼요 받기 +5 / 리뷰 평가 참여(도움돼요·안 돼요 누르기) +5 / 새 가게 첫 정복 +100 / 레벨업 +200 / 티어 상승 +100 / 시즌 보상 +300(티어별로 다르게 가능)
  point       Int     @default(0)
  /// 초안: 글 리뷰 +20
  exp         Int     @default(0)
  /// 하루 최대 지급 횟수 (어뷰징 방지) · null이면 제한 없음 — REVIEW_VOTE는 아무 리뷰나 눌러 포인트를 모으지 못하게 제한을 두는 게 좋다
  dailyLimit  Int?    @map("daily_limit")
  description String? @db.VarChar(100)

  @@map("reward_policy")
}

/// 잔액 변경과 이 표 insert는 한 트랜잭션에서. 사용은 UPDATE member SET point_balance = point_balance - ? WHERE id = ? AND point_balance >= ?
model PointHistory {
  id           BigInt   @id @default(autoincrement())
  userId       BigInt   @map("user_id")
  /// 적립은 +, 사용은 -
  amount       Int
  balanceAfter Int      @map("balance_after")
  /// reward_policy.reason(ITEM_BOX 포함) + PURCHASE / ACHIEVEMENT / ADMIN
  reason       String   @db.VarChar(30)
  /// 먹포인트 내역 화면에 보일 문구 (예: 새맛집 방문 인증, 리뷰 평가 참여, 딸기 모자 구매) — 가게·아이템 이름이 바뀌어도 그대로 남게 저장
  title        String   @db.VarChar(60)
  /// VISIT / REVIEW / REVIEW_REACTION / CONQUEST / ITEM / ITEM_SET / ITEM_BOX / ACHIEVEMENT / LEVEL / SEASON_RESULT / SEASON_REGION_STAT
  refType      String?  @map("ref_type") @db.VarChar(20)
  refId        BigInt?  @map("ref_id")
  regDate      DateTime @default(now()) @map("reg_date")
  user         Member   @relation(fields: [userId], references: [id])

  @@unique([userId, reason, refType, refId], map: "point_history_once_uk")
  @@index([userId, id], map: "point_history_user_idx")
  @@map("point_history")
}

model ExpHistory {
  id         BigInt   @id @default(autoincrement())
  userId     BigInt   @map("user_id")
  amount     Int
  reason     String   @db.VarChar(30)
  refType    String?  @map("ref_type") @db.VarChar(20)
  refId      BigInt?  @map("ref_id")
  levelAfter Int      @map("level_after")
  regDate    DateTime @default(now()) @map("reg_date")
  user       Member   @relation(fields: [userId], references: [id])

  @@unique([userId, reason, refType, refId], map: "exp_history_once_uk")
  @@index([userId, id], map: "exp_history_user_idx")
  @@map("exp_history")
}

/// 개발 대상: 모자 6개 + 왕관, 얼굴 6개, 소품 6개, 밤하늘, 방망이 5종. 등·오라·배경 아이템과 음식 분야 깨비·색깔은 만들지 않는다 (2026-10-06)
model Item {
  id                      Int                @id @default(autoincrement())
  /// HAT_STRAWBERRY, FACE_HEART_SUNGLASSES, PROP_TTEOKKKOCHI, HAT_CROWN, SKIN_NIGHTSKY, CLUB_GOLD 같은 코드 — 프론트 에셋 이름과 맞춘다
  code                    String             @unique @db.VarChar(40)
  /// HAT 모자(6개 + 먹짱 왕관) / FACE 얼굴(6개) / PROP 소품(6개) / SKIN 밤하늘(상위 10% 명예) / CLUB 도깨비 방망이(나무·청동·은·황금 + 합성으로 만드는 전설)
  category                String             @db.VarChar(10)
  name                    String             @db.VarChar(30)
  description             String?            @db.VarChar(255)
  /// 먹포인트 가격 · 모자·얼굴·소품만 판매 · null이면 판매하지 않음
  price                   Int?
  /// D 기본 지급 / P 포인트 구매(모자·얼굴·소품) / S 시즌 보상(방망이 1~4단계) / M 합성(전설의 방망이) / A 업적 보상(왕관·밤하늘, v1.3) / E 이벤트
  unlockType              String             @default("P") @map("unlock_type") @db.Char(1)
  /// 등급 (v1.3, 피그마 에셋 보드) — N 일반 / R 레어 / E 에픽 / L 전설 / H 명예(업적·시즌으로만). 아이템 상자는 레어가 20%
  rarity                  String             @default("N") @db.Char(1)
  /// 방망이 단계 — 1 나무 / 2 청동 / 3 은 / 4 황금(먹짱도 황금) / 5 전설(황금 3개를 합쳐서 만든다)
  clubTier                Int?               @map("club_tier") @db.TinyInt
  /// 이 업적을 달성하면 준다 (v1.3: 왕관·밤하늘은 unlock_type A, 황금 방망이는 시즌 보상이면서 업적 보상이라 S)
  requiredAchievementId   Int?               @map("required_achievement_id")
  /// NEW / HOT — 상점 배지
  badge                   String?            @db.VarChar(10)
  sortOrder               Int                @default(0) @map("sort_order")
  saleStart               DateTime?          @map("sale_start")
  saleEnd                 DateTime?          @map("sale_end")
  /// A 판매·노출 / H 숨김
  status                  String             @default("A") @db.Char(1)
  regDate                 DateTime           @default(now()) @map("reg_date")
  requiredAchievement     Achievement?       @relation(fields: [requiredAchievementId], references: [id])
  seasonResults           SeasonResult[]
  seasonRewardRules       SeasonRewardRule[]
  hatItemMukkaebis        Mukkaebi[]         @relation("mukkaebi_hat_item_id")
  faceItemMukkaebis       Mukkaebi[]         @relation("mukkaebi_face_item_id")
  propItemMukkaebis       Mukkaebi[]         @relation("mukkaebi_prop_item_id")
  skinItemMukkaebis       Mukkaebi[]         @relation("mukkaebi_skin_item_id")
  clubItemMukkaebis       Mukkaebi[]         @relation("mukkaebi_club_item_id")
  itemRecipe              ItemRecipe?        @relation("item_recipe_result_item_id")
  materialItemItemRecipes ItemRecipe[]       @relation("item_recipe_material_item_id")
  memberItems             MemberItem[]
  itemBoxResults          MemberItemBox[]
  itemSetItems            ItemSetItem[]

  @@index([category, status, sortOrder], map: "item_category_idx")
  @@map("item")
}

/// 황금 방망이 3개를 모으면 전설의 방망이로 합칠 수 있다. 합칠 때 member_item에서 황금 방망이 quantity -3, 전설의 방망이 +1 (한 트랜잭션)
model ItemRecipe {
  /// 합성으로 만드는 아이템 — 전설의 방망이 (unlock_type = M)
  resultItemId   Int  @id @map("result_item_id")
  /// 재료 — 황금 방망이
  materialItemId Int  @map("material_item_id")
  /// 필요한 재료 개수 (초안 3개)
  materialCount  Int  @default(3) @map("material_count") @db.TinyInt
  resultItem     Item @relation("item_recipe_result_item_id", fields: [resultItemId], references: [id])
  materialItem   Item @relation("item_recipe_material_item_id", fields: [materialItemId], references: [id])

  @@map("item_recipe")
}

/// 같은 방망이를 또 받으면 행을 늘리지 않고 quantity를 올린다. 시즌마다 받은 방망이는 season_result.reward_club_item_id에도 남는다. 모아 둔 황금 방망이가 없어지면(합성) quantity 0인 행으로 남기고 지우지 않는다
model MemberItem {
  id           BigInt    @id @default(autoincrement())
  userId       BigInt    @map("user_id")
  itemId       Int       @map("item_id")
  /// 가진 개수 — 방망이만 2개 이상이 될 수 있다 (시즌마다 받으면 +1, 합성하면 황금 -3). 모자·얼굴·소품·밤하늘은 항상 1
  quantity     Int       @default(1)
  /// D 기본 지급 / P 구매 / A 업적 보상 / S 시즌 보상 / M 합성 / B 아이템 상자(v1.3) / E 이벤트
  acquiredType String    @map("acquired_type") @db.Char(1)
  /// acquired_type = S일 때 처음 받은 시즌
  seasonId     Int?      @map("season_id")
  acquiredAt   DateTime  @default(now()) @map("acquired_at")
  /// null이면 "새로 얻음" 배지 표시
  seenAt       DateTime? @map("seen_at")
  user         Member    @relation(fields: [userId], references: [id])
  item         Item      @relation(fields: [itemId], references: [id])
  season       Season?   @relation(fields: [seasonId], references: [id])

  @@unique([userId, itemId], map: "member_item_uk")
  @@index([userId, seenAt], map: "member_item_new_idx")
  @@map("member_item")
}

/// 아이템 상자 (v1.3, 피그마 "LV.10 성장 보상 · 아이템 상자를 열어 볼까요?"). 성장 단계가 바뀌는 레벨(3·10·20)에 1개씩.
/// 열면 아직 없는 모자·얼굴·소품 중 하나(레어 20%), 모두 가졌으면 먹포인트
model MemberItemBox {
  id           BigInt    @id @default(autoincrement())
  userId       BigInt    @map("user_id")
  /// LEVEL_UP 성장 보상
  source       String    @db.VarChar(20)
  /// LEVEL_UP이면 그 레벨
  sourceRef    Int       @map("source_ref")
  /// U 안 엶 / O 엶
  status       String    @default("U") @db.Char(1)
  resultItemId Int?      @map("result_item_id")
  /// 줄 아이템이 없어서 대신 준 먹포인트
  resultPoint  Int?      @map("result_point")
  openedAt     DateTime? @map("opened_at")
  regDate      DateTime  @default(now()) @map("reg_date")
  user         Member    @relation(fields: [userId], references: [id])
  resultItem   Item?     @relation(fields: [resultItemId], references: [id])

  @@unique([userId, source, sourceRef], map: "member_item_box_once_uk")
  @@index([userId, status], map: "member_item_box_user_idx")
  @@map("member_item_box")
}

/// 아이템 세트 (v1.3, 피그마 상점 배너 "딸기 모자 세트 · 딸기 모자 + 하트 풍선을 함께!"). 세트 아이템을 하나도 안 가졌을 때만 산다
model ItemSet {
  id          Int           @id @default(autoincrement())
  code        String        @unique @db.VarChar(40)
  name        String        @db.VarChar(30)
  description String?       @db.VarChar(255)
  /// 세트 가격 (따로 사면 각 아이템 가격의 합)
  price       Int
  /// NEW / HOT
  badge       String?       @db.VarChar(10)
  sortOrder   Int           @default(0) @map("sort_order")
  saleStart   DateTime?     @map("sale_start")
  saleEnd     DateTime?     @map("sale_end")
  /// A 판매 / H 숨김
  status      String        @default("A") @db.Char(1)
  regDate     DateTime      @default(now()) @map("reg_date")
  items       ItemSetItem[]

  @@map("item_set")
}

model ItemSetItem {
  setId  Int     @map("set_id")
  itemId Int     @map("item_id")
  set    ItemSet @relation(fields: [setId], references: [id])
  item   Item    @relation(fields: [itemId], references: [id])

  @@id([setId, itemId])
  @@index([itemId], map: "item_set_item_item_idx")
  @@map("item_set_item")
}

/// 알림함은 30일 동안 보관 — 지난 알림은 배치로 지운다. 홈·내 정보의 종 아이콘 빨간 점 = 안 읽은 알림 있음
model Notification {
  id       BigInt   @id @default(autoincrement())
  userId   BigInt   @map("user_id")
  /// RANK 정복·순위 / REVIEW 리뷰 / MUKKAEBI 먹깨비 / NOTICE 공지·이벤트 — 알림함 필터
  category String   @db.VarChar(10)
  /// CONQUEST / RANK_CHANGE / TIER_UP / MUKJJANG / SEASON_END / HELPFUL / SAVED_REMINDER / LEVEL_UP / NEW_ITEM / NOTICE / EVENT / INQUIRY_ANSWER
  type     String   @db.VarChar(20)
  title    String   @db.VarChar(60)
  content  String   @db.VarChar(255)
  refType  String?  @map("ref_type") @db.VarChar(20)
  refId    BigInt?  @map("ref_id")
  isRead   Boolean  @default(false) @map("is_read")
  regDate  DateTime @default(now()) @map("reg_date")
  user     Member   @relation(fields: [userId], references: [id])

  @@index([userId, isRead, id], map: "notification_user_read_idx")
  @@index([userId, category, id], map: "notification_user_category_idx")
  @@index([regDate], map: "notification_reg_date_idx")
  @@map("notification")
}

model Notice {
  id         Int       @id @default(autoincrement())
  title      String    @db.VarChar(100)
  content    String    @db.Text
  /// 필독 / NEW 같은 목록 배지
  tag        String?   @db.VarChar(10)
  isPinned   Boolean   @default(false) @map("is_pinned")
  status     String    @default("A") @db.Char(1)
  regDate    DateTime  @default(now()) @map("reg_date")
  updateDate DateTime? @updatedAt @map("update_date")

  @@map("notice")
}

model Faq {
  id        Int    @id @default(autoincrement())
  /// VISIT 방문 인증 / RANK 정복·순위 / POINT 먹포인트 / ACCOUNT 계정
  category  String @db.VarChar(20)
  question  String @db.VarChar(100)
  answer    String @db.Text
  sortOrder Int    @default(0) @map("sort_order")
  status    String @default("A") @db.Char(1)

  @@map("faq")
}

/// 약관 보기 화면(시행일 선택). 동의 기록은 member_consent가 (type, version)으로 가리킨다
model PolicyDocument {
  id            Int      @id @default(autoincrement())
  /// TERMS 이용약관 / PRIVACY 개인정보 처리방침 / LOCATION 위치기반 서비스
  type          String   @db.VarChar(20)
  /// member_consent.policy_version과 같은 값
  version       String   @db.VarChar(20)
  content       String   @db.Text
  /// 시행일
  effectiveDate DateTime @map("effective_date") @db.Date
  regDate       DateTime @default(now()) @map("reg_date")

  @@unique([type, version], map: "policy_document_type_version_uk")
  @@index([type, effectiveDate], map: "policy_document_type_date_idx")
  @@map("policy_document")
}

/// 고객센터 1:1 문의. 답변이 달리면 앱 알림(notification INQUIRY_ANSWER)으로만 알린다 (이메일은 받지 않는다)
model Inquiry {
  id         BigInt    @id @default(autoincrement())
  userId     BigInt    @map("user_id")
  /// VISIT 방문 인증 / ACCOUNT 계정 / REPORT 신고 / ETC 기타
  category   String    @db.VarChar(20)
  content    String    @db.VarChar(1000)
  /// 방문 인증(영수증·현장) 문제일 때 해당 인증
  refVisitId BigInt?   @map("ref_visit_id")
  /// 첨부 사진 스토리지 key (선택)
  imageKey   String?   @map("image_key") @db.VarChar(255)
  /// W 대기 / D 답변 완료
  status     String    @default("W") @db.Char(1)
  answer     String?   @db.VarChar(1000)
  answeredAt DateTime? @map("answered_at")
  regDate    DateTime  @default(now()) @map("reg_date")
  user       Member    @relation(fields: [userId], references: [id])
  refVisit   Visit?    @relation(fields: [refVisitId], references: [id])

  @@index([userId, regDate], map: "inquiry_user_idx")
  @@map("inquiry")
}

/// 탐방러 프로필 ••• → 신고하기. 신고한 사실은 상대에게 알리지 않는다
model Report {
  id          BigInt            @id @default(autoincrement())
  reporterId  BigInt            @map("reporter_id")
  /// R 리뷰 / M 회원
  targetType  String            @map("target_type") @db.Char(1)
  targetId    BigInt            @map("target_id")
  /// SPAM 스팸·광고 / AD 뒷광고·리뷰 이벤트(협찬을 숨긴 리뷰) / ABUSE 욕설·비방 / FAKE 가짜 리뷰 / PRIVACY 개인정보 노출 / ETC 기타
  reason      String            @db.VarChar(20)
  /// 자세한 내용 (선택, 200자)
  detail      String?           @db.VarChar(200)
  /// P 접수 / A 조치 완료 / R 반려
  status      String            @default("P") @db.Char(1)
  processedAt DateTime?         @map("processed_at")
  regDate     DateTime          @default(now()) @map("reg_date")
  reporter    Member            @relation(fields: [reporterId], references: [id])
  mapaes      RestaurantMapae[]

  @@unique([reporterId, targetType, targetId], map: "report_once_uk")
  @@index([targetType, targetId], map: "report_target_idx")
  @@index([reason, status], map: "report_reason_status_idx")
  @@map("report")
}

/// 탐방러 프로필 ••• → 차단하기. 차단한 사람의 리뷰와 프로필은 목록에서 숨긴다
model MemberBlock {
  blockerId BigInt   @map("blocker_id")
  blockedId BigInt   @map("blocked_id")
  regDate   DateTime @default(now()) @map("reg_date")
  blocker   Member   @relation("member_block_blocker_id", fields: [blockerId], references: [id])
  blocked   Member   @relation("member_block_blocked_id", fields: [blockedId], references: [id])

  @@id([blockerId, blockedId])
  @@map("member_block")
}

/// 신뢰도 가중 별점 계산식의 계수와 전체 평균 m (2026-11-05, ERD v1.0). 계수는 베타 운영·검증 실험 후 조정할 예정이라 코드가 아니라 표에 둔다. GLOBAL_MEAN은 하루 1번 배치가 공개 리뷰 별점 평균으로 바꾼다
model RatingParam {
  /// GLOBAL_MEAN 전체 평균 별점 m / PRIOR_WEIGHT 보정 강도 C / TEMP_BASE / HELP_POS / HELP_NEG / HELP_FULL_COUNT / REVISIT_WEIGHT / DECAY_RATE / DECAY_MIN / DECAY_MONTHS / TRUST_MIN / TRUST_MAX
  code        String    @id @db.VarChar(30)
  value       Decimal   @db.Decimal(8, 4)
  description String?   @db.VarChar(100)
  updateDate  DateTime? @updatedAt @map("update_date")

  @@map("rating_param")
}

/// 신뢰 온도 변화 기록 (2026-11-05 계산식 문서). member.trust_temp를 바꿀 때 같은 트랜잭션에서 넣는다. 하루 상승 한도(오늘 applied_delta > 0 합계 1°), 리뷰당 1번((reason, ref_type, ref_id) unique), 같은 사람 월 한도(이번 달 같은 (user_id, actor_id)의 HELPFUL_* 3개)를 이 표로 센다
model TrustTempLog {
  id           BigInt   @id @default(autoincrement())
  /// 온도가 바뀐 사람 (리뷰 작성자)
  userId       BigInt   @map("user_id")
  /// HELPFUL_VISITOR +0.2 / HELPFUL_GUEST +0.05 / REVIEW_WRITTEN +0.1 / UNHELPFUL_MANY −0.5 / REPORT_CONFIRMED −3 / FAKE_REVIEW −5
  reason       String   @db.VarChar(20)
  /// 규칙대로의 변화량
  baseDelta    Decimal  @map("base_delta") @db.Decimal(4, 2)
  /// 실제로 바뀐 양 — 75° 이상 절반, 하루 +1° 한도, 1°~99° 범위로 잘린 뒤의 값 (0일 수 있다)
  appliedDelta Decimal  @map("applied_delta") @db.Decimal(4, 2)
  /// 바뀐 뒤 온도
  tempAfter    Decimal  @map("temp_after") @db.Decimal(4, 2)
  /// 온도를 바꾼 사람 (도움돼요를 누른 사람). 시스템·운영자 처리는 null
  actorId      BigInt?  @map("actor_id")
  /// REVIEW_REACTION / REVIEW / REPORT
  refType      String   @map("ref_type") @db.VarChar(20)
  /// HELPFUL_*면 review_reaction.id, REVIEW_WRITTEN·UNHELPFUL_MANY·FAKE_REVIEW면 review.id, REPORT_CONFIRMED면 report.id
  refId        BigInt   @map("ref_id")
  regDate      DateTime @default(now()) @map("reg_date")
  user         Member   @relation("trust_temp_log_user_id", fields: [userId], references: [id])
  actor        Member?  @relation("trust_temp_log_actor_id", fields: [actorId], references: [id])

  @@unique([reason, refType, refId], map: "trust_temp_log_once_uk")
  @@index([userId, regDate], map: "trust_temp_log_user_date_idx")
  @@index([userId, actorId, regDate], map: "trust_temp_log_actor_idx")
  @@map("trust_temp_log")
}

/// [2차] 개인화용 행동 기록 (2026-11-04, 3차 멘토링). 방문 인증·리뷰·저장·검색 기록과 합쳐 사용자 특성을 계산한다. 90일 지난 행은 집계 후 지운다(초안)
model MemberActivityLog {
  id          BigInt   @id @default(autoincrement())
  userId      BigInt   @map("user_id")
  /// 앱을 한 번 열고 닫을 때까지의 id (프론트에서 UUID로 만든다)
  sessionId   String?  @map("session_id") @db.Char(36)
  /// APP_OPEN / APP_CLOSE / SCREEN_VIEW / RESTAURANT_VIEW / REVIEW_LIST_VIEW / SEARCH / RECOMMEND_CLICK / SAVE / UNSAVE
  eventType   String   @map("event_type") @db.VarChar(30)
  /// 화면 이름 (SCREEN_VIEW일 때) 예) restaurant_detail
  screen      String?  @db.VarChar(40)
  /// RESTAURANT / REVIEW / CATEGORY / REGION
  refType     String?  @map("ref_type") @db.VarChar(20)
  refId       BigInt?  @map("ref_id")
  /// 화면·앱에 머문 시간(초)
  durationSec Int?     @map("duration_sec")
  /// 검색어, 추천 탭 이름 같은 추가 정보
  meta        Json?
  regDate     DateTime @default(now()) @map("reg_date")
  user        Member   @relation(fields: [userId], references: [id])

  @@index([userId, regDate], map: "member_activity_log_user_date_idx")
  @@index([eventType, regDate], map: "member_activity_log_type_date_idx")
  @@map("member_activity_log")
}

/// 세부평가의 좋았던 점·아쉬웠던 점 칩 목록 (2026-11-04). 표에 두어 배포 없이 칩을 바꾼다
model ReviewAspect {
  id        Int                    @id @default(autoincrement()) @db.TinyInt
  /// TASTE 맛 / PORTION 양 / PRICE 가격 / SERVICE 서비스 / CLEAN 청결 / WAIT 대기시간 / MOOD 분위기
  code      String                 @unique @db.VarChar(20)
  /// 칩에 보이는 이름 (좋음/아쉬움은 화면에서 붙인다)
  name      String                 @db.VarChar(20)
  sortOrder Int                    @default(0) @map("sort_order") @db.TinyInt
  /// A 사용 / H 숨김
  status    String                 @default("A") @db.Char(1)
  marks     ReviewAspectMark[]
  stats     RestaurantAspectStat[]

  @@map("review_aspect")
}

/// 항목 선택형 리뷰 — 리뷰 하나에 항목마다 최대 1개
model ReviewAspectMark {
  reviewId BigInt       @map("review_id")
  aspectId Int          @map("aspect_id") @db.TinyInt
  /// G 좋았던 점 / B 아쉬웠던 점
  polarity String       @db.Char(1)
  regDate  DateTime     @default(now()) @map("reg_date")
  review   Review       @relation(fields: [reviewId], references: [id])
  aspect   ReviewAspect @relation(fields: [aspectId], references: [id])

  @@id([reviewId, aspectId])
  @@index([aspectId], map: "review_aspect_mark_aspect_idx")
  @@map("review_aspect_mark")
}

/// 가게별 좋았던 점·아쉬웠던 점 집계 (2026-11-04). 리뷰가 추가·삭제될 때 good/bad_count를 +1/-1, recent_*는 하루 1번 배치
model RestaurantAspectStat {
  restaurantId    BigInt       @map("restaurant_id")
  aspectId        Int          @map("aspect_id") @db.TinyInt
  /// 좋았던 점으로 고른 리뷰 수
  goodCount       Int          @default(0) @map("good_count")
  /// 아쉬웠던 점으로 고른 리뷰 수
  badCount        Int          @default(0) @map("bad_count")
  /// 최근 6개월 좋았던 점 수 — 배치로 다시 계산
  recentGoodCount Int          @default(0) @map("recent_good_count")
  /// 최근 6개월 아쉬웠던 점 수
  recentBadCount  Int          @default(0) @map("recent_bad_count")
  updateDate      DateTime?    @updatedAt @map("update_date")
  restaurant      Restaurant   @relation(fields: [restaurantId], references: [id])
  aspect          ReviewAspect @relation(fields: [aspectId], references: [id])

  @@id([restaurantId, aspectId])
  @@map("restaurant_aspect_stat")
}

/// 내 PICK (ERD v1.2, 피그마 내 PICK 편집·탐방러 프로필 PICK). 내가 정복한 가게 중에서 최대 10곳, 한 줄 코멘트는 선택.
/// 탐방러 프로필과 구 랭킹 TOP 3에서 다른 탐방러에게 보인다. 고칠 때는 통째로 지우고 다시 넣는다(PICK-02)
model MemberPick {
  userId       BigInt     @map("user_id")
  restaurantId BigInt     @map("restaurant_id")
  /// 보여 주는 순서 0~9
  sortOrder    Int        @map("sort_order") @db.TinyInt
  /// 한 줄 코멘트 (선택, 30자)
  comment      String?    @db.VarChar(30)
  regDate      DateTime   @default(now()) @map("reg_date")
  user         Member     @relation(fields: [userId], references: [id])
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])

  @@id([userId, restaurantId])
  @@unique([userId, sortOrder], map: "member_pick_order_uk")
  @@index([restaurantId], map: "member_pick_restaurant_idx")
  @@map("member_pick")
}

/// 맞춤 퀘스트 한 주 (피그마 12. 맞춤 퀘스트, 2026-11-10). 회원마다 주(KST 월요일 시작)에 1행 — 그 주에 퀘스트를 처음 열 때 만든다
model QuestWeek {
  id          BigInt    @id @default(autoincrement())
  userId      BigInt    @map("user_id")
  /// 그 주 월요일 (KST)
  weekStart   DateTime  @map("week_start") @db.Date
  /// 받은 기본 퀘스트 수 — 지난 4주 평균 방문 (주 0~1회 2개 / 2~3회 3개 / 4회 이상 4개). 고를 가게가 모자라면 그보다 적다
  baseCount   Int       @map("base_count") @db.TinyInt
  /// L 활동 적음 / M 보통 / H 많음 (지난 4주 평균 방문)
  activity    String    @db.Char(1)
  /// 이번 주 "다른 퀘스트로 바꾸기"를 쓴 시각 (주 1번)
  swappedAt   DateTime? @map("swapped_at")
  /// 기본 퀘스트를 모두 깬 시각 — 주간 아이템 상자(member_item_box source QUEST_WEEK)를 준다
  completedAt DateTime? @map("completed_at")
  regDate     DateTime  @default(now()) @map("reg_date")
  user        Member    @relation(fields: [userId], references: [id])
  quests      Quest[]

  @@unique([userId, weekStart], map: "quest_week_user_week_uk")
  @@map("quest_week")
}

/// 퀘스트 한 개. 가게 선택과 순서는 우리 DB와 계산식이 정하고(같은 구 안), 이유 문장도 서버가 만든다
model Quest {
  id               BigInt      @id @default(autoincrement())
  weekId           BigInt      @map("week_id")
  userId           BigInt      @map("user_id")
  /// NEW_TASTE 새 맛 탐험 / MY_STANDARD 내 기준 맛집 / WIDEN_MENU 메뉴 넓히기 / LOCAL_PICK 동네 새 가게(맞춤 추천을 껐거나 기록이 모자랄 때)
  /// / NEXT_DONG 옆 동네 한 바퀴 / TIER_UP 티어 도전 / FIRST_REVIEWER 첫 평가자 / SAVED_VISIT 저장한 곳 가기
  type             String      @db.VarChar(20)
  /// E 쉬움 / X 탐험 / C 도전
  level            String      @db.Char(1)
  /// 가 볼 가게 — 옆 동네 한 바퀴·티어 도전은 null (그 동·구에서 아무 곳이나)
  restaurantId     BigInt?     @map("restaurant_id")
  /// 옆 동네 한 바퀴: 새로 정복할 동 (region.level = 3)
  regionId         Int?        @map("region_id")
  /// 깨려면 정복할 곳 수 (가게 퀘스트는 1)
  target           Int         @default(1) @db.TinyInt
  progress         Int         @default(0) @db.TinyInt
  /// "단골 국밥집 말고 새 국밥집"
  title            String      @db.VarChar(60)
  /// 목록의 셋째 줄 (예: 최근 한 달 방문의 70%가 같은 국밥집이에요)
  summary          String      @db.VarChar(100)
  /// "왜 나에게 왔나요?" 문장 2~3개 (JSON 문자열 배열)
  reasons          Json
  /// 깨면 줄 먹포인트 (만들 때 reward_policy QUEST_EASY·EXPLORE·CHALLENGE 값)
  rewardPoint      Int         @map("reward_point")
  /// 이번 주 기본 퀘스트를 모두 깬 뒤 열리는 보너스 퀘스트 (주간 상자 조건에는 안 들어간다)
  isBonus          Boolean     @default(false) @map("is_bonus")
  /// A 진행 중 / C 완료 / S 다른 퀘스트로 바꿈 / D 관심 없어요
  status           String      @default("A") @db.Char(1)
  /// 퀘스트를 깬 가게 (퀘스트 기록 "퀘스트로 간 곳", 업적 "새 맛 수집가")
  doneRestaurantId BigInt?     @map("done_restaurant_id")
  completedAt      DateTime?   @map("completed_at")
  regDate          DateTime    @default(now()) @map("reg_date")
  week             QuestWeek   @relation(fields: [weekId], references: [id])
  user             Member      @relation(fields: [userId], references: [id])
  restaurant       Restaurant? @relation("quest_restaurant_id", fields: [restaurantId], references: [id])
  doneRestaurant   Restaurant? @relation("quest_done_restaurant_id", fields: [doneRestaurantId], references: [id])
  region           Region?     @relation(fields: [regionId], references: [id])

  @@index([userId, status], map: "quest_user_status_idx")
  @@index([userId, restaurantId, regDate], map: "quest_user_restaurant_idx")
  @@map("quest")
}

/// "관심 없어요"를 누른 퀘스트 종류 — 많이 누른 종류일수록 덜 추천한다
model QuestDislike {
  userId     BigInt   @map("user_id")
  type       String   @db.VarChar(20)
  count      Int      @default(1)
  updateDate DateTime @default(now()) @updatedAt @map("update_date")
  user       Member   @relation(fields: [userId], references: [id])

  @@id([userId, type])
  @@map("quest_dislike")
}
