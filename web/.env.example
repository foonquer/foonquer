# 복사해서 .env.local로 쓴다. .env.local은 커밋하지 않는다.

# API 서버 주소. 로컬 개발은 비워 두면 vite 프록시가 http://localhost:3000으로 넘긴다.
# 배포(Vercel)에서는 서버 도메인을 넣는다. 예) https://api.foodking.example
VITE_API_BASE_URL=

# 카카오 지도 JavaScript 키 (카카오 개발자 콘솔 > 앱 키 > JavaScript 키).
# 플랫폼 > Web 사이트 도메인에 http://localhost:5173과 배포 주소를 등록해야 한다.
# 비워 두면 홈 지도가 가게 위치만 보여 주는 간단한 지도로 뜬다.
VITE_KAKAO_MAP_KEY=
